# starter/config.env.example — copy to config.env and edit. NEVER commit config.env.
#
# Every path here is a LOCAL path. There is no correct default: set them for your
# machine. Paths are written POSIX-style even on Windows, because the tools are
# invoked from Cygwin/MSYS2.

# ---------------------------------------------------------------- root
# Where the open EDA toolchain lives.
EDA_ROOT=D:/ipason/EDA

# PDK. $PDK_ROOT/$PDK must contain libs.tech/ and libs.ref/
PDK_ROOT=$EDA_ROOT/open-pdks-sky130/share/pdk
PDK=sky130A
STDCELL_LIB=sky130_fd_sc_hd

# ---------------------------------------------------------------- tools
# Place-and-route
MICROLANE_ORIG=$EDA_ROOT/microlane
MICROLANE_SRC=$EDA_ROOT/microlane_dbexport/src

# Windows only: Cygwin root used by the isolated launcher.
# Leave empty on Linux / macOS / inside the TinyTapeout VM.
CYGWIN_ROOT=D:/ipason/EDA/Cygwin

# ---------------------------------------------------------------- run
# One directory per run. NEVER reuse a RUN_DIR across runs: a reused path makes
# the recorded SHA meaningless.
RUN_DIR=$EDA_ROOT/runs/run01
PROJECT_NAME=my_first_gds
SOURCE_VERILOG=$RUN_DIR/source.v

# ---------------------------------------------------------------- determinism
# All three are required for a reproducible GDS. Do not remove any of them.
PYTHONHASHSEED=0
GDS_TIMESTAMP_FROZEN=1
# Frozen timestamp written into the GDS header (Unix seconds).
# Any fixed value works; it must be the SAME value on every run.
GDS_TIMESTAMP=1700000000

# ---------------------------------------------------------------- launcher
# Isolated environment. MSYS2_ARG_CONV_EXCL prevents MSYS from "helpfully"
# rewriting Windows-style paths into something the tools cannot open.
MSYS2_ARG_CONV_EXCL=*
